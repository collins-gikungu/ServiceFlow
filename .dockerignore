# ==========================================
# Build artifacts (regenerated inside container)
# ==========================================
**/bin/
**/obj/
**/out/
**/publish/
**/Debug/
**/Release/
**/x64/
**/x86/

# ==========================================
# IDE / editor
# ==========================================
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.swp
*.swo

# ==========================================
# Git & GitHub
# ==========================================
.git/
.gitignore
.gitattributes
.github/

# ==========================================
# Docker
# ==========================================
Dockerfile*
docker-compose*.yml
.dockerignore

# ==========================================
# NuGet
# ==========================================
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# ==========================================
# Secrets / environment (never bake into image)
# ==========================================
.env
.env.*
!.env.example
secrets.json
appsettings.*.local.json

# ==========================================
# OS junk
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Logs & temp
# ==========================================
*.log
logs/
tmp/
temp/

# ==========================================
# Node (in case you add a frontend / tooling later)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*